{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/*.mjs", "scripts/demo/*.mjs"],
      "project": ["scripts/**/*.{ts,mjs}"]
    },
    "packages/cli": {
      "entry": ["src/render/web/browser/client.ts"],
      "project": "src/**/*.ts"
    },
    "packages/core": {
      "project": "src/**/*.ts"
    }
  },
  // demo scripts run from a temp dir where playwright is installed on the fly (scripts/demo/*.sh)
  "ignoreDependencies": ["playwright"],
  // mkfifo: tests exercise non-regular-file handling; openssl: tests make a throwaway TLS certificate (skipped when absent)
  "ignoreBinaries": ["mkfifo", "openssl"]
  // renderTerminal is used only by tests; knip counts tests as entries, so it needs no entry here
}
