{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "defaults": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string",
          "enum": [
            "auto",
            "cli",
            "web",
            "both",
            "none"
          ]
        },
        "context": {
          "type": "string",
          "enum": [
            "short",
            "full"
          ]
        },
        "flows": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "request"
          ]
        },
        "terminalMaxNodes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "outDir": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        },
        "minNodes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "keep": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxAgeDays": {
          "type": "number",
          "minimum": 0
        },
        "open": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "product": {
          "description": "Product name on the cover of a release map (default: the repo name)",
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
        },
        "logo": {
          "description": "Repo-relative path to an .svg or .png of at most 200 KB, shown on the cover of a release map",
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
        },
        "browser": {
          "description": "Global only: absolute path of the Chromium-based browser that prints a release map to PDF (default: Chrome, Chromium, Edge or Brave where they are usually installed)",
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
        },
        "branches": {
          "description": "Branches that are release branches, as globs (default: v[0-9]*, release-*, release/*)",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
          }
        },
        "auto": {
          "description": "On a release branch: suggest a release map, draw one, or do nothing (default: suggest)",
          "type": "string",
          "enum": [
            "suggest",
            "draw",
            "off"
          ]
        }
      },
      "additionalProperties": false
    },
    "useBuiltinRules": {
      "type": "boolean"
    },
    "ignore": {
      "description": "Paths the desktop app's live map never reads, as globs, on top of .gitignore, dependencies and build output. The CLI doesn't use it.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
      }
    },
    "updateCheck": {
      "description": "Global only: look up the newest codechart on npm at most once a day and say when there is one (default true)",
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "diagram": {
            "type": "string",
            "enum": [
              "map",
              "flow"
            ]
          },
          "paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
            }
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
          },
          "output": {
            "type": "string",
            "enum": [
              "auto",
              "cli",
              "web",
              "both",
              "none"
            ]
          },
          "context": {
            "type": "string",
            "enum": [
              "short",
              "full"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "map": {
      "description": "The desktop app's map: its rules, guidance for the model and pinned names. The CLI doesn't use it.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rules": {
              "description": "Top-down, first match wins, before the app's built-in rules",
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "paths": {
                        "description": "Globs the rule matches",
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
                        }
                      },
                      "pattern": {
                        "description": "Tree-sitter query; the @entity capture is what the rule applies to",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "allOf": [
                          {
                            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
                          },
                          {
                            "pattern": "@entity(?![\\w.-])"
                          }
                        ]
                      },
                      "lang": {
                        "description": "The pattern's tree-sitter grammar",
                        "type": "string",
                        "enum": [
                          "typescript",
                          "javascript",
                          "python",
                          "html",
                          "css",
                          "sql",
                          "bash",
                          "yaml",
                          "json"
                        ]
                      },
                      "kind": {
                        "description": "The code is an entity of this kind",
                        "type": "string",
                        "enum": [
                          "table",
                          "model",
                          "service",
                          "endpoint",
                          "component",
                          "config"
                        ]
                      },
                      "box": {
                        "description": "The code belongs to this box",
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                      },
                      "ignore": {
                        "description": "The code is read but left off the map",
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "guidance": {
              "description": "Plain words for the model that names and groups boxes",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pinned": {
              "description": "Names a person pinned, by box id or node id (file::path::kind); written sorted by id",
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300,
                        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b\\u200c\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
