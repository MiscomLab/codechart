{
  "name": "@codechart/core",
  "version": "0.1.0",
  "description": "Shared engine for codechart: map and flow schemas, truth checks, layout, git rules, review notes, config, agent presets",
  "type": "module",
  "license": "MIT",
  "author": "MiscomLab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiscomLab/codechart.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/MiscomLab/codechart/issues"
  },
  "homepage": "https://github.com/MiscomLab/codechart/tree/main/packages/core#readme",
