{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@codechart/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "tests", "scripts", "*.config.ts", "packages/*/*.config.ts"]
}
