{
  "name": "codechart-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "codechart: the CLI and the shared engine it runs on",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiscomLab/codechart.git"
  },
  "bugs": {
    "url": "https://github.com/MiscomLab/codechart/issues"
  },
  "homepage": "https://github.com/MiscomLab/codechart#readme",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @codechart/core && npm run build -w codechart",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "lint": "eslint .",
    "measure": "tsx scripts/measure.ts",
    "bench:tokens": "tsx scripts/token-bench.ts",
    "gen:config-schema": "tsx scripts/gen-config-schema.ts",
    "complexity": "node scripts/complexity.mjs",
    "dup": "jscpd packages --threshold 1 --ignore \"**/tests/**\" && jscpd packages --threshold 3 --ignore \"**/src/**\"",
    "knip": "knip",
    "gen:client": "tsx scripts/gen-client.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.14.0",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "tsup": "^9.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
